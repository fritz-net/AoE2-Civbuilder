# --- Stage 1: Build C++ binaries ---
FROM node:20-bullseye AS cpp-build

# Install build tools for C++ compilation
RUN apt-get update && \
    apt-get install -y build-essential cmake liblz4-dev libboost-iostreams-dev libjsoncpp-dev dos2unix && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy modding directory (git submodules should be initialized by CI before docker build)
COPY modding/ modding/

# Ensure Unix line endings for build.sh to avoid cross-platform issues
RUN dos2unix modding/scripts/build.sh && chmod +x modding/scripts/build.sh

# Build all C++ targets (run from modding directory so CMakeLists.txt works)
RUN cd ./modding/ && ./scripts/build.sh

# --- Stage 2: Build Node.js app and assemble final image ---
FROM node:20-bullseye AS build

RUN apt-get update && \
    apt-get install -y dos2unix libjsoncpp24 zip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files and install backend dependencies
COPY package*.json ./
RUN npm ci --omit=dev

# Copy backend source code (excluding frontend for better caching)
COPY public/ ./public/
COPY process_mod/ ./process_mod/
COPY lib/ ./lib/
COPY nuxt-integration.js ./
COPY server.js ./

# Copy built C++ build directory from cpp-build stage
COPY --from=cpp-build /app/modding/build /app/modding/build
COPY modding/scripts/ ./modding/scripts/

# Ensure Unix line endings for shell scripts
RUN find ./process_mod -name "*.sh" -exec dos2unix {} \; && \
    find ./modding/scripts -name "*.sh" -exec dos2unix {} \;

# Copy frontend package files and install dependencies
COPY src/frontend/package*.json src/frontend/
RUN cd src/frontend && npm ci

# Copy frontend source and build
COPY src/frontend/ src/frontend/
RUN cd src/frontend && npm run generate

ENV NODE_ENV=production

EXPOSE 4000

VOLUME ["/app/modding/requested_mods"]

ENTRYPOINT ["node", "server.js"]
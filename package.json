{
  "scripts": {
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  },
  "dependencies": {
    "axios": "^0.21.1",
    "body-parser": "^1.19.0",
    "canvas": "^2.11.2",
    "cookie-parser": "^1.4.6",
    "express": "^4.17.1",
    "express-easy-zip": "^1.1.5",
    "pug": "^3.0.2",
    "socket.io": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jest": "^29.7.0",
    "playwright": "^1.56.1"
  }
}

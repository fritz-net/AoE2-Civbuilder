# AoE2 Civbuilder Environment Configuration

# Hostname for the application (used for generating links)
# Default: https://krakenmeister.com/civbuilder
# For local development: http://localhost:4000
CIVBUILDER_HOSTNAME=http://localhost:4000

# Enable C++ execution inside Docker container
# Set to 1 or true to run C++ binaries in Docker
# Set to 0 or false (or leave unset) to run C++ binaries locally
# Default: false (local execution)
CPP_IN_DOCKER=0

# Note: The dev scripts in package.json automatically set CPP_IN_DOCKER=1
# If you want to test local C++ execution during development, use:
#   npm run dev:server:local
